# Pinned Beszel release tag (no leading 'v'). Must match deploy/agent-install/*.
# Bump: update here, linux-systemd.sh, windows-install.ps1 in lockstep.
BESZEL_VERSION=0.18.7

# Agent public key from the Beszel hub admin UI. Beszel generates this on first
# hub launch; grab it from Settings -> Add System.
BESZEL_AGENT_KEY=

# API token for the frontend's authenticated reads (server-side only). Create
# via PocketBase admin UI once the hub is up.
BESZEL_API_TOKEN=

# URL the frontend uses to reach the hub. Inside the compose network this is
# http://beszel-hub:8090; from the host it's http://localhost:8090.
PUBLIC_BESZEL_URL=http://beszel-hub:8090

# LAN IP of bserver (`ip -4 addr show | grep -v lo` on bserver). The frontend
# container's host port binds to this IP so aserver's nginx can reverse-proxy
# to it over the LAN.
BSERVER_LAN_IP=192.168.1.100

# Host port on BSERVER_LAN_IP that the SvelteKit frontend listens on. Studio
# (supabase-server) holds 3000 on the same bserver LAN IP; analytics uses 3001.
ANALYTICS_HOST_PORT=3001
