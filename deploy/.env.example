# Pinned Beszel release tag (no leading 'v'). Must match deploy/agent-install/*.
# Bump: update here, linux-systemd.sh, windows-install.ps1 in lockstep.
BESZEL_VERSION=0.18.7

# Agent public key from the Beszel hub admin UI. Beszel generates this on first
# hub launch; grab it from Settings -> Add System. The compose stack no longer
# uses it (the agent runs via systemd; see the note at the bottom of this file)
# but it's kept here so the value lives in one place — pass it to the agent
# install script via --key=<value>.
BESZEL_AGENT_KEY=

# API token for the frontend's authenticated reads (server-side only). Create
# via PocketBase admin UI once the hub is up.
BESZEL_API_TOKEN=

# URL the frontend uses to reach the hub. Inside the compose network this is
# http://beszel-hub:8090; from the host it's http://localhost:8090.
PUBLIC_BESZEL_URL=http://beszel-hub:8090

# LAN IP of bserver (`ip -4 addr show | grep -v lo` on bserver). The frontend
# container's host port binds to this IP so aserver's nginx can reverse-proxy
# to it over the LAN. The hub also binds here so nginx can serve /_/ and /api/.
BSERVER_LAN_IP=192.168.1.100

# Tailscale IP of bserver (`tailscale ip -4` on bserver). The hub also binds
# here so the Beszel bundled admin UI is reachable from any tailnet client at
# http://<BSERVER_TS_IP>:8090/ — used to register agents (Settings -> Systems).
# The custom dashboard at https://analytics.<your-domain>/ doesn't include an
# Add-System form, so the bundled UI is the only way to register new agents.
BSERVER_TS_IP=100.64.0.1

# Host port on BSERVER_LAN_IP that the SvelteKit frontend listens on. Studio
# (supabase-server) holds 3000 on the same bserver LAN IP; analytics uses 3001.
ANALYTICS_HOST_PORT=3001

# Note: the Beszel agent does NOT read this file. The agent runs as a systemd
# service (see deploy/agent-install/linux-systemd.sh) so it has full host
# visibility — required to track filesystems beyond the rootfs. To register
# extra filesystems, pass `--extra-filesystems=/path[,path...]` to the install
# script on the target host.
